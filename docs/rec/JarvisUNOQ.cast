[111.267, "o", "\u001b[90m┌─ scripts/jarvis-chat.py · trim_history() y bucle ─────────────────────────────────────────────────────\u001b[0m\n"]
[111.267, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtrim_history\u001b[39;49;00m(history, max_messages):\u001b[90m\u001b[39;49;00m\n"]
[111.322, "o", "\u001b[90m 106\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(history) <= max_messages + \u001b[94m1\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[111.377, "o", "\u001b[90m 107\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m history\u001b[90m\u001b[39;49;00m\n"]
[111.432, "o", "\u001b[90m 108\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m [history[\u001b[94m0\u001b[39;49;00m]] + history[-(max_messages):]\u001b[90m\u001b[39;49;00m\n"]
[111.487, "o", "\u001b[90m 109\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[111.542, "o", "\u001b[90m 110\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[111.597, "o", "\u001b[90m 111\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mrun_interactive\u001b[39;49;00m(args):\u001b[90m\u001b[39;49;00m\n"]
[111.652, "o", "\u001b[90m 112\u001b[0m\u001b[90m │ \u001b[0m    history = [{\u001b[33m\"\u001b[39;49;00m\u001b[33mrole\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33msystem\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mcontent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: args.system}]\u001b[90m\u001b[39;49;00m\n"]
[111.707, "o", "\u001b[90m 113\u001b[0m\u001b[90m │ \u001b[0m    \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mJarvis local · modelo \u001b[39;49;00m\u001b[33m{\u001b[39;49;00margs.model\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[111.762, "o", "\u001b[90m 114\u001b[0m\u001b[90m │ \u001b[0m    \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mEscribí \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33msalir\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m para terminar.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[111.817, "o", "\u001b[90m 115\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mwhile\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[111.872, "o", "\u001b[90m 116\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[111.927, "o", "\u001b[90m 117\u001b[0m\u001b[90m │ \u001b[0m            prompt = \u001b[96minput\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mVos > \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).strip()\u001b[90m\u001b[39;49;00m\n"]
[111.982, "o", "\u001b[90m 118\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mexcept\u001b[39;49;00m (\u001b[96mEOFError\u001b[39;49;00m, \u001b[96mKeyboardInterrupt\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[112.037, "o", "\u001b[90m 119\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mprint\u001b[39;49;00m()\u001b[90m\u001b[39;49;00m\n"]
[112.092, "o", "\u001b[90m 120\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mbreak\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[112.147, "o", "\u001b[90m 121\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m prompt:\u001b[90m\u001b[39;49;00m\n"]
[112.202, "o", "\u001b[90m 122\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mcontinue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
