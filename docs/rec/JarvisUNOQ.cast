[47.079, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0mDEFAULT_HOST = os.environ.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mOLLAMA_HOST\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m127.0.0.1:11434\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[47.134, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0mDEFAULT_SYSTEM = (\u001b[90m\u001b[39;49;00m\n"]
[47.189, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mSos Jarvis, un asistente conversacional local para el auto. Respondés en \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.244, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mespañol rioplatense, breve, claro y útil. En este modo de chat solo podés \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.299, "o", "\u001b[90m  15\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mconversar: NO tenés acceso a archivos, disco, cámara, internet, sensores \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.354, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mni comandos. Si te preguntan por esas capacidades, decí que no las tenés. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.409, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mNo inventes datos ni acciones. Tampoco sabés cuánto tardás en responder: \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.464, "o", "\u001b[90m  18\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mno inventes tiempos ni métricas. Respondé únicamente a la última pregunta \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.519, "o", "\u001b[90m  19\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33my no repitas respuestas anteriores. Usá 1 a 3 oraciones y menos de 60 \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.574, "o", "\u001b[90m  20\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mpalabras, salvo que pidan más detalle.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[47.629, "o", "\u001b[90m  21\u001b[0m\u001b[90m │ \u001b[0m)\u001b[90m\u001b[39;49;00m\n"]
