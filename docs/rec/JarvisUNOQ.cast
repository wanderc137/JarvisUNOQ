[173.425, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m    fields = stat.rsplit(\u001b[33m\"\u001b[39;49;00m\u001b[33m) \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m1\u001b[39;49;00m)[-\u001b[94m1\u001b[39;49;00m].split()\u001b[90m\u001b[39;49;00m\n"]
[173.48, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0m    ticks = \u001b[96mint\u001b[39;49;00m(fields[\u001b[94m11\u001b[39;49;00m]) + \u001b[96mint\u001b[39;49;00m(fields[\u001b[94m12\u001b[39;49;00m])\u001b[90m\u001b[39;49;00m\n"]
[173.535, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m    rss = \u001b[96mint\u001b[39;49;00m(statm[\u001b[94m1\u001b[39;49;00m]) * PAGE_SIZE\u001b[90m\u001b[39;49;00m\n"]
[173.59, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m    name = stat.split(\u001b[33m\"\u001b[39;49;00m\u001b[33m(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m1\u001b[39;49;00m)[-\u001b[94m1\u001b[39;49;00m].split(\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m1\u001b[39;49;00m)[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n"]
