[173.205, "o", "\u001b[90m  41\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mwith\u001b[39;49;00m \u001b[96mopen\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m/proc/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mpid\u001b[33m}\u001b[39;49;00m\u001b[33m/statm\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, encoding=\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mas\u001b[39;49;00m handle:\u001b[90m\u001b[39;49;00m\n"]
[173.26, "o", "\u001b[90m  42\u001b[0m\u001b[90m │ \u001b[0m            statm = handle.read().split()\u001b[90m\u001b[39;49;00m\n"]
[173.315, "o", "\u001b[90m  43\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m (\u001b[96mFileNotFoundError\u001b[39;49;00m, \u001b[96mProcessLookupError\u001b[39;49;00m, \u001b[96mPermissionError\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
