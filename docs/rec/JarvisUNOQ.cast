[80.575, "o", "\u001b[90m┌─ scripts/jarvis-chat.py · manejo de errores ──────────────────────────────────────────────────────────\u001b[0m\n"]
[80.575, "o", "\u001b[90m  83\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m urllib.error.HTTPError \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
[80.63, "o", "\u001b[90m  84\u001b[0m\u001b[90m │ \u001b[0m        body = exc.read().decode(\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, errors=\u001b[33m\"\u001b[39;49;00m\u001b[33mreplace\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[80.685, "o", "\u001b[90m  85\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mError HTTP \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mexc.code\u001b[33m}\u001b[39;49;00m\u001b[33m: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mbody\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, file=sys.stderr)\u001b[90m\u001b[39;49;00m\n"]
[80.74, "o", "\u001b[90m  86\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[80.795, "o", "\u001b[90m  87\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m urllib.error.URLError \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
[80.85, "o", "\u001b[90m  88\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[80.905, "o", "\u001b[90m  89\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mNo se pudo conectar con Ollama. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[80.96, "o", "\u001b[90m  90\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mEjecutá scripts/start-jarvis.sh o revisá el servicio ollama.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[81.015, "o", "\u001b[90m  91\u001b[0m\u001b[90m │ \u001b[0m            file=sys.stderr,\u001b[90m\u001b[39;49;00m\n"]
[81.07, "o", "\u001b[90m  92\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[81.125, "o", "\u001b[90m  93\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mDetalle: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mexc\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, file=sys.stderr)\u001b[90m\u001b[39;49;00m\n"]
[81.18, "o", "\u001b[90m  94\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.235, "o", "\u001b[90m  95\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m \u001b[96mTimeoutError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[81.29, "o", "\u001b[90m  96\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mOllama no respondió a tiempo.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, file=sys.stderr)\u001b[90m\u001b[39;49;00m\n"]
[81.345, "o", "\u001b[90m  97\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
